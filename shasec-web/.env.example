# Kortex Security web console — copy to .env.local.
# URL of the Kortex/shaapi API as seen from the Next.js SERVER (never shipped to
# the browser: every API call goes through the /api/k proxy route). Inside Docker
# this can be the internal service URL.
SHAAPI_URL=http://localhost:8000
# Name of the refresh-token cookie set by the API (settings.COOKIE_REFRESH_TOKEN_KEY).
SHAAPI_REFRESH_COOKIE=monshaapi_refresh_token
# Set to "true" when served over HTTPS so session cookies get the Secure flag.
COOKIE_SECURE=false
